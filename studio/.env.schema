# Sanity Studio config. SANITY_STUDIO_* values are bundled into the browser,
# so nothing secret belongs here. Scripts load this via `varlock run`.
# This env file uses @env-spec - see https://varlock.dev/env-spec for more info
#
# @import(../, pick=[VERCEL_ENV, APP_ENV, SANITY_PROJECT_ID, SANITY_DATASET])
# @currentEnv=$APP_ENV
# @defaultRequired=infer @defaultSensitive=false
# ----------

# @required
SANITY_STUDIO_PROJECT_ID=$SANITY_PROJECT_ID

# @required @type=enum(production)
SANITY_STUDIO_DATASET=$SANITY_DATASET

# @type=string(matches="^v?\d{4}-\d{2}-\d{2}$")
# @docs(https://www.sanity.io/docs/api-versioning)
SANITY_STUDIO_API_VERSION=

# Hostname for `sanity deploy` (<host>.sanity.studio)
SANITY_STUDIO_STUDIO_HOST=
