{
  "name": "@eclipse/studio",
  "private": true,
  "version": "1.0.0",
  "main": "package.json",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "sanity dev",
    "start": "sanity start",
    "build": "sanity build",
    "deploy": "sanity deploy",
    "deploy-graphql": "sanity graphql deploy",
    "typegen": "sanity typegen generate",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "prettier:fix": "prettier --write \"**/*.{ts,js,tsx}\"",
    "prettier:check": "prettier --check .",
    "schema:extract": "sanity schema extract --enforce-required-fields --path ../sanity.schema.json"
  },
  "keywords": [
    "sanity"
  ],
  "dependencies": {
    "@sanity/icons": "3.7.4",
    "@sanity/vision": "5.14.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sanity": "5.14.1",
    "styled-components": "6.3.11"
  },
  "devDependencies": {
    "@sanity/eslint-config-studio": "6.0.0",
    "@types/react": "19.2.14",
    "eslint": "9.39.3",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  }
}
