{
  "name": "@eclipse/studio",
  "private": true,
  "version": "1.0.0",
  "main": "package.json",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "varlock run -- sanity dev",
    "start": "varlock run -- sanity start",
    "build": "varlock run -- sanity build",
    "deploy": "varlock run -- sanity deploy",
    "deploy-graphql": "varlock run -- sanity graphql deploy",
    "typegen": "sanity typegen generate",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "prettier:fix": "prettier --write \"**/*.{ts,js,tsx}\"",
    "prettier:check": "prettier --check .",
    "schema:extract": "varlock run -- sanity schema extract --enforce-required-fields --path ../sanity.schema.json --force"
  },
  "keywords": [
    "sanity"
  ],
  "dependencies": {
    "@portabletext/toolkit": "6.0.0",
    "@sanity/icons": "5.2.2",
    "@sanity/vision": "6.17.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sanity": "6.17.0",
    "sanity-plugin-tags-v4": "1.0.22",
    "styled-components": "6.5.3"
  },
  "devDependencies": {
    "@sanity/eslint-config-studio": "6.0.0",
    "@types/react": "19.3.0",
    "@varlock/vite-integration": "1.5.2",
    "eslint": "9.39.3",
    "prettier": "3.9.8",
    "typescript": "5.9.3",
    "varlock": "1.21.1"
  }
}
