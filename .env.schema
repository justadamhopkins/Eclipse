# Shared config for the Eclipse monorepo.
# Packages (frontend/, studio/) import from here and map these to their own prefixed names.
# This env file uses @env-spec - see https://varlock.dev/env-spec for more info
#
# @currentEnv=$APP_ENV
# @defaultRequired=infer @defaultSensitive=false
# ----------

# Injected by Vercel on deploys - not set locally
# @type=enum(development, preview, production)
# @docs(https://vercel.com/docs/environment-variables/system-environment-variables)
VERCEL_ENV=

# Current environment - selects which .env.[APP_ENV] files are loaded
# @type=enum(development, preview, production, test)
APP_ENV=fallback($VERCEL_ENV, development)

# Sanity project the studio and frontend both talk to
# @docs(https://www.sanity.io/manage/project/o7fi7oqy)
SANITY_PROJECT_ID=o7fi7oqy

# @type=enum(production)
SANITY_DATASET=production
