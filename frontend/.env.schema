# @encryptInjectedEnv
# Next.js frontend config. Local secrets go in .env.local (gitignored),
# deployed values come from the Vercel project's environment variables.
# This env file uses @env-spec - see https://varlock.dev/env-spec for more info
#
# @import(../, pick=[VERCEL_ENV, APP_ENV, SANITY_PROJECT_ID, SANITY_DATASET])
# @currentEnv=$APP_ENV
# @defaultRequired=infer @defaultSensitive=inferFromPrefix('NEXT_PUBLIC_')
# @generateTsTypes(path=env.d.ts)
# ----------
SECRET_KEY= # @sensitive

# @required
NEXT_PUBLIC_SANITY_PROJECT_ID=$SANITY_PROJECT_ID

# @required @type=enum(production)
NEXT_PUBLIC_SANITY_DATASET=$SANITY_DATASET

# Dated API version, e.g. 2025-01-01
# @required @type=string(matches="^v?\d{4}-\d{2}-\d{2}$")
# @docs(https://www.sanity.io/docs/api-versioning)
NEXT_PUBLIC_SANITY_API_VERSION=

# Viewer token used by sanityFetch() on the server
# @required @sensitive
# @docs(https://www.sanity.io/docs/http-auth)
SANITY_READ_TOKEN=
